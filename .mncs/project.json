{
  "schema_version": "mncs-family.repository-manifest/v0alpha1",
  "repository": "mncs-automation",
  "revision": 3,
  "manifest_location": "in-repository",
  "authority": {
    "note": "mncs-automation owns persistent automation semantics (definitions, schedules, watches, occurrences, invocation intent); execution, planning, actions, events, telemetry, verdicts, and provenance stay with their owning subsystems."
  },
  "organization": {
    "layout": "mncs.repository-layout/1",
    "surfaces": [
      {
        "path": "docs/",
        "class": "canonical",
        "authority": "mncs-automation",
        "artifact_class": "authoritative"
      },
      {
        "path": "native/",
        "class": "canonical",
        "authority": "mncs-automation",
        "note": "Native time/schedule/trigger/evaluation/reconcile semantics with self-contained test blocks.",
        "artifact_class": "authoritative"
      },
      {
        "path": "tools/",
        "class": "host-boundary",
        "note": "Thin transport bridge: clocks, tzdata, atomic persistence, wakeup loop, condition observation, typed target execution, CLI. No decision logic."
      },
      {
        "path": "tests/",
        "class": "canonical",
        "note": "Deterministic host suite over virtual time plus fixtures.",
        "artifact_class": "authoritative"
      },
      {
        "path": ".mncs/project-state.json",
        "class": "canonical",
        "authority": "mncs-automation",
        "note": "Authored project intent; execution state is evidence-derived.",
        "artifact_class": "authoritative"
      },
      {
        "path": ".mncs/projections.json",
        "class": "canonical",
        "authority": "mncs-automation",
        "note": "Explicit semantic projection ownership and dependencies.",
        "artifact_class": "authoritative"
      },
      {
        "path": "README.md",
        "class": "generated",
        "note": "Mixed: only delimited semantic region is projection-owned; surrounding authored bytes are protected.",
        "artifact_class": "mixed"
      },
      {
        "path": "ROADMAP.md",
        "class": "generated",
        "note": "Mixed: projected evidence board beside preserved authored intent.",
        "artifact_class": "mixed"
      },
      {
        "path": ".mncs/project-view.json",
        "class": "generated",
        "note": "Derived machine-facing interpretation; never an execution input.",
        "artifact_class": "derived"
      }
    ]
  },
  "contracts": {
    "provides": [
      {
        "contract": "automation-definition",
        "version": "1",
        "kind": "persistent-automation-definition",
        "stability": "experimental",
        "fingerprint_sources": [
          "tools/automation/model.py",
          "tests/test_automation.py"
        ]
      },
      {
        "contract": "automation-evaluation",
        "version": "1",
        "kind": "native-tick-decision",
        "stability": "experimental",
        "fingerprint_sources": [
          "native/",
          "tools/automation/native.py",
          "tests/test_automation.py"
        ]
      },
      {
        "contract": "automation-occurrence",
        "version": "1",
        "kind": "occurrence-and-invocation-record",
        "stability": "experimental",
        "fingerprint_sources": [
          "tools/automation/engine.py",
          "tests/test_automation.py"
        ]
      },
      {
        "contract": "automation-reconciliation",
        "version": "1",
        "kind": "native-reconcile-decision",
        "stability": "experimental",
        "effects": [
          "read"
        ],
        "fingerprint_sources": [
          "native/mncs/automation/reconcile.mncs",
          "native/mncs/automation/projection.mncs",
          "tools/reconcile.py",
          "tools/automation/native.py",
          "tools/automation/codes.py",
          "tests/test_reconcile.py",
          "docs/rfcs/0002-projection-coherence.md",
          "native/mncs/automation/revisit.mncs"
        ],
        "invocation": {
          "kind": "python",
          "path": "tools/reconcile.py",
          "fixed_argv": [
            "plan"
          ],
          "toolchain": {
            "repository": "mncs-language",
            "path": "target/release/mncs"
          },
          "toolchain_env": "MNCS_BIN"
        }
      },
      {
        "contract": "automation-adoption",
        "version": "1",
        "kind": "native-adopt-decision",
        "stability": "experimental",
        "effects": [
          "read"
        ],
        "fingerprint_sources": [
          "native/mncs/automation/reconcile.mncs",
          "tools/reconcile.py",
          "tools/automation/native.py",
          "tools/automation/codes.py",
          "tests/test_reconcile.py",
          "docs/rfcs/0002-projection-coherence.md"
        ],
        "invocation": {
          "kind": "python",
          "path": "tools/reconcile.py",
          "fixed_argv": [
            "adopt"
          ],
          "toolchain": {
            "repository": "mncs-language",
            "path": "target/release/mncs"
          },
          "toolchain_env": "MNCS_BIN"
        }
      },
      {
        "contract": "automation-revisit",
        "version": "1",
        "kind": "native-revisit-decision",
        "stability": "experimental",
        "effects": [
          "read"
        ],
        "fingerprint_sources": [
          "native/mncs/automation/projection.mncs",
          "tools/reconcile.py",
          "tools/automation/native.py",
          "tools/automation/codes.py",
          "tests/test_reconcile.py",
          "docs/rfcs/0002-projection-coherence.md",
          "native/mncs/automation/revisit.mncs"
        ],
        "invocation": {
          "kind": "python",
          "path": "tools/reconcile.py",
          "fixed_argv": [
            "revisit"
          ],
          "toolchain": {
            "repository": "mncs-language",
            "path": "target/release/mncs"
          },
          "toolchain_env": "MNCS_BIN"
        }
      },
      {
        "contract": "coherence-routing",
        "version": "1",
        "kind": "native-affected-pass-decision",
        "stability": "experimental",
        "effects": [
          "read"
        ],
        "fingerprint_sources": [
          "native/mncs/automation/coherence.mncs",
          "native/mncs/automation/revisit.mncs",
          "tests/test_coherence.py",
          "docs/INCREMENTAL_COHERENCE.md"
        ]
      },
      {
        "contract": "coherence-artifact-reconcile",
        "version": "1",
        "kind": "bounded-provider-artifact-reconcile",
        "effects": [
          "read",
          "execute"
        ],
        "artifact_declaration": ".mncs/coherence-artifact.json",
        "output_scope": "selected Environment provider cache; no source edits or publication",
        "fingerprint_sources": [
          ".mncs/coherence-artifact.json",
          "tools/coherence_provider.py",
          "native/mncs/automation/provider.mncs"
        ],
        "stability": "experimental"
      }
    ],
    "consumes": [
      {
        "contract": "mncs.compiler.call/1",
        "envelope": {
          "op": "any"
        },
        "required": true
      },
      {
        "contract": "mncs.compiler.test/1",
        "envelope": {
          "op": "any"
        },
        "required": true
      },
      {
        "contract": "mncs.compiler.declaration-inventory/1",
        "envelope": {
          "op": "any"
        },
        "required": true
      },
      {
        "contract": "mncs-doctor.report/1",
        "envelope": {
          "op": "any"
        },
        "required": false
      },
      {
        "contract": "mncs-commons.provider-provenance",
        "required": false,
        "envelope": {
          "op": "any"
        },
        "evidence_refs": [
          ".mncs/coherence-artifact.json"
        ],
        "scope": "retained coherence provider"
      },
      {
        "contract": "mncs-doctor.provider-artifact-remediation",
        "required": false,
        "envelope": {
          "op": "any"
        },
        "evidence_refs": [
          ".mncs/coherence-artifact.json"
        ],
        "scope": "retained coherence provider"
      },
      {
        "contract": "mncs-forge.provider-artifact-execution",
        "required": false,
        "envelope": {
          "op": "any"
        },
        "evidence_refs": [
          "tools/coherence_provider.py"
        ],
        "scope": "retained coherence provider"
      }
    ],
    "tests": [
      {
        "test": "automation-tests",
        "covers": [
          "automation-definition",
          "automation-evaluation",
          "automation-occurrence"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "python3",
            "-m",
            "unittest",
            "tests.test_automation"
          ]
        }
      },
      {
        "test": "reconcile-tests",
        "covers": [
          "automation-reconciliation",
          "automation-adoption",
          "automation-revisit"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "python3",
            "-m",
            "unittest",
            "tests.test_reconcile"
          ]
        }
      },
      {
        "test": "coherence-routing-tests",
        "covers": [
          "coherence-routing"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "python3",
            "-m",
            "pytest",
            "-q",
            "tests/test_coherence.py"
          ]
        }
      }
    ]
  },
  "projections": [
    {
      "id": "mncs-automation:rfc-index",
      "template": "project-rfc-index",
      "inputs": [
        "docs/rfcs"
      ],
      "output": "docs/rfc-index.generated.md",
      "output_kind": "whole-file",
      "provider_capability": "mncs-doc:documentation-projection",
      "render_argv": [
        "project-rfc-index",
        "--rfc-root",
        "{checkout}/docs/rfcs",
        "--output",
        "{artifact}/rendered.md",
        "--link-base",
        "{checkout}/docs/rfc-index.generated.md"
      ],
      "policy": "ambient-safe",
      "verification": {
        "obligations": [
          "mncs-doc:verification-executor/mncs-doc.projection-check"
        ]
      }
    }
  ],
  "projection_inventory": ".mncs/projections.json",
  "structure_profile": {
    "repository": "machine-native-complexity-development-specification",
    "path": "profiles/semantic-project.json",
    "identity": "sha256:259e41ea542e7a1400f1471b0316de4fafc888d6f953c8e91165ff2cfe1e78cb"
  }
}
