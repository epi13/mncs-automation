mncs 0.17;

// mncs.automation.evaluation — one total evaluation step.
//
// `evaluate_tick` is the semantic heart of Automation: given a schedule
// (or a watch observation), prior state, policy codes, and `now`, it
// decides exactly one thing — fire one occurrence, or wait — and says
// when to look again. The host executes the decision; it never invents
// one. Ticks are idempotent: re-evaluating the same state at the same
// instant returns the same decision, so replay and crash recovery are
// defined behavior.
//
// Time mapping comes from mncs.automation.schedule; edge semantics from
// mncs.automation.trigger. This module owns firing policy: misfire
// selection and the single-decision tick.
//
// Decision reasons (codes shared with the host adapter):
//   0 due-fire            one occurrence is eligible now.
//   1 waiting             nothing due yet; `wakeup_ms` names the revisit.
//   2 already-fired       dedup: newest due seq is already recorded.
//   3 cond-false          watch observed FALSE.
//   4 cond-unknown        watch observed UNKNOWN.
//   5 edge-closed         watch TRUE (or repeat) but the edge did not open.
//   6 misfire-skipped     policy recorded due seqs as missed, fired none.
// Host-only reasons (never emitted here): 7 concurrency-suppressed,
// 8 stale-target, 9 terminal (completed/expired).
//
// `wakeup_ms` of 0 means "no future instant is implied; use the watch
// cadence or sleep until an external change".
//
// Misfire policy codes: 0 FireNow, 1 Skip, 2 CatchUp, 3 MarkMissed.

module mncs.automation.evaluation.v1;

use mncs.automation.schedule;
use mncs.automation.trigger;
use mncs.test.assertions;
use mncs.test.suite;

record TickDecision { fire: bool, seq: u64, at_ms: i64, wakeup_ms: i64, reason: u64, missed_from: u64, missed_to: u64, new_prev: u64 }

record SeqPick { fire: bool, fire_seq: u64, missed_from: u64, missed_to: u64, new_prev: u64 }

fn reason_due_fire() -> (code: u64) {
    return 0;
}

fn reason_waiting() -> (code: u64) {
    return 1;
}

fn reason_already_fired() -> (code: u64) {
    return 2;
}

fn reason_cond_false() -> (code: u64) {
    return 3;
}

fn reason_cond_unknown() -> (code: u64) {
    return 4;
}

fn reason_edge_closed() -> (code: u64) {
    return 5;
}

fn reason_misfire_skipped() -> (code: u64) {
    return 6;
}

fn misfire_fire_now() -> (code: u64) {
    return 0;
}

fn misfire_skip() -> (code: u64) {
    return 1;
}

fn misfire_catch_up() -> (code: u64) {
    return 2;
}

fn misfire_mark_missed() -> (code: u64) {
    return 3;
}

// Choose what fires given `prev_seq` already recorded, `cur_seq` now
// due, a catch-up bound, and the misfire policy. Fires at most one
// occurrence; missed ranges are reported for the host to record, never
// executed in a loop. An empty missed range has missed_from > missed_to.
// Pinned schedules (kind 0) carry singleton seq labels, not contiguous
// counts: any newer seq fires as-is with no range.
fn select_fire(kind: u64, prev_seq: u64, cur_seq: u64, bound: u64, misfire: u64) -> (result: SeqPick) {
    let none: SeqPick = SeqPick { fire: false, fire_seq: 0, missed_from: 1, missed_to: 0, new_prev: prev_seq };
    if cur_seq <= prev_seq {
        return none;
    }
    if kind == 0 {
        return SeqPick { fire: true, fire_seq: cur_seq, missed_from: 1, missed_to: 0, new_prev: cur_seq };
    }
    if misfire == misfire_fire_now() {
        return SeqPick { fire: true, fire_seq: cur_seq, missed_from: prev_seq +% 1, missed_to: cur_seq -% 1, new_prev: cur_seq };
    }
    if misfire == misfire_skip() {
        return SeqPick { fire: false, fire_seq: 0, missed_from: prev_seq +% 1, missed_to: cur_seq, new_prev: cur_seq };
    }
    if misfire == misfire_mark_missed() {
        return SeqPick { fire: false, fire_seq: 0, missed_from: prev_seq +% 1, missed_to: cur_seq, new_prev: cur_seq };
    }
    if bound == 0 {
        return SeqPick { fire: true, fire_seq: cur_seq, missed_from: prev_seq +% 1, missed_to: cur_seq -% 1, new_prev: cur_seq };
    }
    let oldest: u64 = prev_seq +% 1;
    let window_start: u64 = select(cur_seq > bound, cur_seq -% bound +% 1, 1);
    if oldest < window_start {
        return SeqPick { fire: true, fire_seq: window_start, missed_from: oldest, missed_to: window_start -% 1, new_prev: window_start };
    }
    return SeqPick { fire: true, fire_seq: oldest, missed_from: 1, missed_to: 0, new_prev: oldest };
}

// One evaluation step. Schedule branch (`trig_kind` 0) derives due
// sequences from time; watch branch (1) derives them from the edge.
// `last_at_ms` is the instant of `prev_seq` (0 when none); `misfire`
// selects the skip/catch-up policy; `bound` caps catch-up distance.
// `first` is 1 on a schedule's first evaluation ever (prev 0, never
// evaluated): anchorless schedules (Interval, DailyUtc) align to now
// instead of catching up from the epoch, so history before creation
// never fires. Pinned schedules (one-shots, host-resolved pins) always
// evaluate normally: a single future or past-due instant has no history.
fn evaluate_tick(sched_kind: u64, p1: i64, p2: i64, trig_kind: u64, edge: u64, prev_cond: u64, cond: u64, prev_seq: u64, last_at_ms: i64, now_ms: i64, misfire: u64, bound: u64, first: u64) -> (result: TickDecision) {
    let waiting: TickDecision = TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: 0, reason: reason_waiting(), missed_from: 1, missed_to: 0, new_prev: 0 };
    if trig_kind == 1 {
        if cond == cond_code(CondValue.Unknown) {
            return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: 0, reason: reason_cond_unknown(), missed_from: 1, missed_to: 0, new_prev: prev_seq };
        }
        if cond == cond_code(CondValue.False) {
            return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: 0, reason: reason_cond_false(), missed_from: 1, missed_to: 0, new_prev: prev_seq };
        }
        if should_fire(edge, prev_cond, cond) {
            return TickDecision { fire: true, seq: prev_seq +% 1, at_ms: now_ms, wakeup_ms: 0, reason: reason_due_fire(), missed_from: 1, missed_to: 0, new_prev: prev_seq +% 1 };
        }
        return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: 0, reason: reason_edge_closed(), missed_from: 1, missed_to: 0, new_prev: prev_seq };
    }
    if first == 1 && prev_seq == 0 && sched_kind != 0 {
        let cur: u64 = current_seq(sched_kind, p1, p2, now_ms);
        let ahead: NextOccurrence = next_after(sched_kind, p1, p2, now_ms);
        return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: select(ahead.found, ahead.at_ms, 0), reason: reason_waiting(), missed_from: 1, missed_to: 0, new_prev: cur };
    }
    let nxt: NextOccurrence = next_after(sched_kind, p1, p2, last_at_ms);
    if nxt.found == false {
        if prev_seq > 0 {
            return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: 0, reason: reason_already_fired(), missed_from: 1, missed_to: 0, new_prev: prev_seq };
        }
        return waiting;
    }
    if nxt.at_ms > now_ms {
        return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: nxt.at_ms, reason: reason_waiting(), missed_from: 1, missed_to: 0, new_prev: prev_seq };
    }
    let cur: u64 = current_seq(sched_kind, p1, p2, now_ms);
    if cur <= prev_seq {
        return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: nxt.at_ms, reason: reason_already_fired(), missed_from: 1, missed_to: 0, new_prev: prev_seq };
    }
    let pick: SeqPick = select_fire(sched_kind, prev_seq, cur, bound, misfire);
    if pick.fire == false {
        return TickDecision { fire: false, seq: 0, at_ms: 0, wakeup_ms: nxt.at_ms, reason: reason_misfire_skipped(), missed_from: pick.missed_from, missed_to: pick.missed_to, new_prev: pick.new_prev };
    }
    let fired_at: i64 = at_for_seq(sched_kind, p1, p2, pick.fire_seq);
    let after_fire: NextOccurrence = next_after(sched_kind, p1, p2, fired_at);
    return TickDecision { fire: true, seq: pick.fire_seq, at_ms: fired_at, wakeup_ms: select(after_fire.found, after_fire.at_ms, 0), reason: reason_due_fire(), missed_from: pick.missed_from, missed_to: pick.missed_to, new_prev: pick.new_prev };
}

test fire_now_skips_intermediates() -> (result: TestResult) {
    let pick: SeqPick = select_fire(1, 2, 5, 10, misfire_fire_now());
    if pick.fire && pick.fire_seq == 5 && pick.missed_from == 3 && pick.missed_to == 4 && pick.new_prev == 5 {
        return from_assertion(equals_i64(1, 1, 5301));
    }
    return from_assertion(equals_i64(1, 0, 5301));
}

test catch_up_fires_oldest_within_bound() -> (result: TestResult) {
    let pick: SeqPick = select_fire(1, 2, 9, 3, misfire_catch_up());
    if pick.fire && pick.fire_seq == 7 && pick.missed_from == 3 && pick.missed_to == 6 && pick.new_prev == 7 {
        return from_assertion(equals_i64(1, 1, 5302));
    }
    return from_assertion(equals_i64(1, 0, 5302));
}

test dedup_never_refires() -> (result: TestResult) {
    let pick: SeqPick = select_fire(1, 5, 5, 10, misfire_fire_now());
    return from_assertion(equals_bool(false, pick.fire, 5303));
}

test oneshot_fires_exactly_once() -> (result: TestResult) {
    let first: TickDecision = evaluate_tick(0, 1000, 1, 0, 0, 0, 0, 0, 0, 1000, 0, 10, 0);
    let replay: TickDecision = evaluate_tick(0, 1000, 1, 0, 0, 0, 0, 1, 1000, 5000, 0, 10, 0);
    if first.fire && first.seq == 1 && first.at_ms == 1000 && replay.fire == false && replay.reason == reason_already_fired() {
        return from_assertion(equals_i64(1, 1, 5304));
    }
    return from_assertion(equals_i64(1, 0, 5304));
}

test interval_tick_is_idempotent() -> (result: TestResult) {
    let a: TickDecision = evaluate_tick(1, 0, 1000, 0, 0, 0, 0, 0, 0, 2500, 0, 10, 0);
    let b: TickDecision = evaluate_tick(1, 0, 1000, 0, 0, 0, 0, 0, 0, 2500, 0, 10, 0);
    if a.fire && a.seq == 3 && b.fire && b.seq == 3 && a.at_ms == 2000 && a.wakeup_ms == 3000 {
        return from_assertion(equals_i64(3, a.seq as i64, 5305));
    }
    return from_assertion(equals_i64(3, a.seq as i64, 5305));
}

test waiting_names_the_revisit() -> (result: TestResult) {
    let wait: TickDecision = evaluate_tick(1, 0, 1000, 0, 0, 0, 0, 0, 0, 100, 0, 10, 0);
    if wait.fire == false && wait.reason == reason_waiting() && wait.wakeup_ms == 1000 {
        return from_assertion(equals_i64(1000, wait.wakeup_ms, 5306));
    }
    return from_assertion(equals_i64(1000, wait.wakeup_ms, 5306));
}

test watch_rising_edge_fires_once() -> (result: TestResult) {
    let fire: TickDecision = evaluate_tick(0, 0, 0, 1, 0, 0, 1, 4, 0, 9000, 0, 10, 0);
    let again: TickDecision = evaluate_tick(0, 0, 0, 1, 0, 1, 1, 5, 9000, 9500, 0, 10, 0);
    if fire.fire && fire.seq == 5 && fire.at_ms == 9000 && again.fire == false && again.reason == reason_edge_closed() {
        return from_assertion(equals_i64(5, fire.seq as i64, 5307));
    }
    return from_assertion(equals_i64(5, fire.seq as i64, 5307));
}

test watch_unknown_never_fires() -> (result: TestResult) {
    let dark: TickDecision = evaluate_tick(0, 0, 0, 1, 0, 0, 2, 4, 0, 9000, 0, 10, 0);
    return from_assertion(equals_bool(false, dark.fire, 5308));
}

test pinned_seq_fires_as_singleton() -> (result: TestResult) {
    let pick: SeqPick = select_fire(0, 20500, 20617, 3, misfire_catch_up());
    if pick.fire && pick.fire_seq == 20617 && pick.new_prev == 20617 && pick.missed_from > pick.missed_to {
        return from_assertion(equals_i64(1, 1, 5312));
    }
    return from_assertion(equals_i64(1, 0, 5312));
}

test skip_policy_records_without_firing() -> (result: TestResult) {
    let skip: TickDecision = evaluate_tick(1, 0, 1000, 0, 0, 0, 0, 0, 0, 5500, 1, 10, 0);
    if skip.fire == false && skip.reason == reason_misfire_skipped() {
        return from_assertion(equals_i64(6, skip.reason as i64, 5309));
    }
    return from_assertion(equals_i64(6, skip.reason as i64, 5309));
}

test first_evaluation_aligns_without_firing() -> (result: TestResult) {
    let align: TickDecision = evaluate_tick(1, 0, 1000, 0, 0, 0, 0, 0, 0, 5500, 0, 10, 1);
    if align.fire == false && align.reason == reason_waiting() && align.new_prev == 6 && align.wakeup_ms == 6000 {
        return from_assertion(equals_i64(6, align.new_prev as i64, 5310));
    }
    return from_assertion(equals_i64(6, align.new_prev as i64, 5310));
}

test first_flag_leaves_pinned_alone() -> (result: TestResult) {
    let pin: TickDecision = evaluate_tick(0, 1000, 1, 0, 0, 0, 0, 0, 0, 5000, 0, 10, 1);
    if pin.fire && pin.seq == 1 {
        return from_assertion(equals_i64(1, pin.seq as i64, 5311));
    }
    return from_assertion(equals_i64(1, pin.seq as i64, 5311));
}
